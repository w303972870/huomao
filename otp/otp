package huomao_otp

import (
	"bytes"
	"crypto/hmac"
	"crypto/sha1"
	"encoding/base32"
	"encoding/binary"
	"fmt"
	"net/url"
	"strings"
	"time"
)

func (this *otp) un() int64 {
	return time.Now().UnixNano() / 1000 / 30
}

func (this *otp) hmacSha1(key, data []byte) []byte {
	h := hmac.New(sha1.New, key)
	if total := len(data); total > 0 {
		h.Write(data)
	}
	return h.Sum(nil)
}

func (this *otp) base32encode(src []byte) string {
	return base32.StdEncoding.EncodeToString(src)
}

func (this *otp) base32decode(s string) ([]byte, error) {
	return base32.StdEncoding.DecodeString(s)
}

func (this *otp) toBytes(value int64) []byte {
	var result []byte
	mask := int64(0xFF)
	shifts := [8]uint16{56, 48, 40, 32, 24, 16, 8, 0}
	for _, shift := range shifts {
		result = append(result, byte((value>>shift)&mask))
	}
	return result
}

func (this *otp) toUint32(bts []byte) uint32 {
	return (uint32(bts[0]) << 24) + (uint32(bts[1]) << 16) +
		(uint32(bts[2]) << 8) + uint32(bts[3])
}

func (this *otp) oneTimePassword(key []byte, data []byte) uint32 {
	hash := this.hmacSha1(key, data)
	offset := hash[len(hash)-1] & 0x0F
	hashParts := hash[offset : offset+4]
	hashParts[0] = hashParts[0] & 0x7F
	number := this.toUint32(hashParts)
	return number % 1000000
}

// 获取秘钥
func (this *otp) GetSecret() string {
	var buf bytes.Buffer
	binary.Write(&buf, binary.BigEndian, this.un())
	return strings.ToUpper(this.base32encode(this.hmacSha1(buf.Bytes(), nil)))
}

// 获取动态码
func (this *otp) GetCode(secret string) (string, error) {
	secretUpper := strings.ToUpper(secret)
	secretKey, err := this.base32decode(secretUpper)
	if err != nil {
		return "", err
	}
	number := this.oneTimePassword(secretKey, this.toBytes(time.Now().Unix()/30))
	return fmt.Sprintf("%06d", number), nil
}

// 获取动态码二维码内容
func (this *otp) GetQrcode(name string, ukey string) string {
	return fmt.Sprintf(fmt.Sprint("otpauth://totp/%s?secret=%s&issuer=HMSSO-", name, "&algorithm=SHA1&digits=6&period=30"), name, ukey)
}

// 获取动态码二维码图片地址,这里是第三方二维码api
func (this *otp) GetQrcodeUrl(name string, ukey string) string {
	data := url.Values{}
	data.Set("data", this.GetQrcode(name, ukey))
	return "https://api.qrserver.com/v1/create-qr-code/?" + data.Encode() +
		"&size=" + fmt.Sprintf("%s", this.Width) + "x" + fmt.Sprintf("%s", this.Height) + "&ecc=M"
}

// 验证动态码
func (this *otp) VerifyCode(secret, code string) (bool, error) {
	_code, err := this.GetCode(secret)
	if err != nil {
		return false, err
	}
	return _code == code, nil
}
